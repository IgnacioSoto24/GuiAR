# 📘 Evaluación de GuiAR con RAGAS

# --- Imports ---
from ragas.metrics import faithfulness, answer_relevance, context_precision, context_recall
from ragas import evaluate
from datasets import Dataset
import pandas as pd
import matplotlib.pyplot as plt

# --- Dataset de prueba con preguntas reales ---
data = {
    "question": [
        "¿Qué son los Objetivos de Aprendizaje en Historia 3º medio?",
        "¿Qué habilidades desarrolla Ciencias para la Ciudadanía en 3º medio?",
        "¿Cuál es el propósito de los ejes en Lengua y Literatura?",
        "¿Qué competencias transversales se buscan en Matemática 3º medio?",
        "¿Cómo se relaciona la formación ciudadana con el currículum de Historia?"
    ],
    "answer": [
        "Los Objetivos de Aprendizaje son metas definidas en el currículum oficial.",
        "Promueve investigación, análisis crítico y toma de decisiones responsables.",
        "Los ejes buscan organizar los aprendizajes en torno a comprensión, comunicación y creación.",
        "Se fomenta el razonamiento lógico, la resolución de problemas y el pensamiento crítico.",
        "La formación ciudadana se integra para promover participación responsable y análisis histórico."
    ],
    "contexts": [
        ["Los Objetivos de Aprendizaje corresponden a las metas establecidas en el currículum."],
        ["Ciencias para la Ciudadanía busca que los estudiantes comprendan fenómenos científicos y tomen decisiones responsables."],
        ["El currículum de Lengua y Literatura organiza los aprendizajes en ejes que orientan la comprensión lectora, la comunicación y la producción textual."],
        ["La asignatura de Matemática busca desarrollar competencias transversales como pensamiento crítico, resolución de problemas y razonamiento lógico."],
        ["El currículum de Historia integra la formación ciudadana para promover participación democrática, responsabilidad y análisis crítico."]
    ],
    "ground_truth": [
        "Definición oficial de OA en Historia 3º medio según MINEDUC.",
        "Según el currículum, desarrolla investigación científica y ciudadanía responsable.",
        "Los ejes son estructuras que agrupan aprendizajes en comprensión, comunicación y creación.",
        "Se busca pensamiento crítico, resolución de problemas y razonamiento lógico.",
        "Se vincula a la participación democrática y al análisis crítico de procesos sociales."
    ]
}

dataset = Dataset.from_dict(data)

# --- Evaluación ---
resultados = evaluate(
    dataset=dataset,
    metrics=[faithfulness, answer_relevance, context_precision, context_recall]
)

# --- Mostrar resultados en DataFrame ---
df = pd.DataFrame([resultados])
display(df)

# --- Guardar en CSV ---
df.to_csv("../Metricas/resultados_ragas.csv", index=False)
print("✅ Resultados guardados en ../Metricas/resultados_ragas.csv")

# --- Visualización ---
df.plot(kind="bar", figsize=(12,6))
plt.title("Resultados métricas RAGAS")
plt.ylabel("Score (0-1)")
plt.xticks(rotation=0)
plt.ylim(0,1)
plt.show()
